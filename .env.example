# Copy to .env for local development. On Render, set these in the dashboard.

APP_ENV=development              # "production" on Render
SECRET_KEY=change-me-to-64-random-characters   # python -c "import secrets; print(secrets.token_hex(32))"
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata

# ---- Storage --------------------------------------------------------------
STORAGE_BACKEND=sheets           # "sheets" (Google Sheet) or "excel" (local file)
GOOGLE_SHEET_ID=                 # the long ID in https://docs.google.com/spreadsheets/d/<ID>/edit
# Service account key: paste the whole JSON (or base64 of it) …
GOOGLE_SERVICE_ACCOUNT_JSON=
# … or point to the key file instead (local dev only)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
EXCEL_PATH=Daily.xlsx            # used only when STORAGE_BACKEND=excel
CACHE_TTL_SECONDS=60

# Month picker range
TIMELINE_START=2023-07
TIMELINE_MONTHS_AHEAD=6

# ---- Google sign-in -------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=you@gmail.com     # comma-separated
# AUTH_DISABLED=true             # local dev only; refused when APP_ENV=production
